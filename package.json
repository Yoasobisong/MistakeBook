{
  "name": "cuotiben",
  "version": "0.1.0",
  "private": true,
  "description": "错题本 — 本地优先的错题管理，支持 AI 提取与分析",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build --mode web",
    "build:app": "vite build --mode app",
    "preview": "vite preview",
    "app": "npm run build:app && electron .",
    "dev:app": "node scripts/dev-app.mjs",
    "dist": "npm run build:app && electron-builder"
  },
  "build": {
    "appId": "com.cuotiben.app",
    "productName": "错题本",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "错题本",
      "artifactName": "Cuotiben-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Cuotiben-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "katex": "^0.18.1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.0"
  }
}
