# Cloudflare Worker 配置模板。
#
# 复制本文件为 wrangler.toml（已加入 .gitignore，不会提交），
# 然后在 Cloudflare 面板创建 D1 数据库和 KV 命名空间，把真实 ID 填进来：
#
#   cp wrangler.toml.example wrangler.toml
#
# 面板路径：
#   D1 数据库：Workers & Pages → D1 → 创建「cuotiben」→ 复制 Database ID
#   KV 命名空间：存储和数据库 → KV → 创建「cuotiben-images」→ 复制 Namespace ID
#
# PUSH_TOKEN / VIEW_KEY 不要写在这里 —— 用 `wrangler secret put` 设置，
# 免得跟着仓库一起进 GitHub。
#
#   wrangler secret put PUSH_TOKEN   写接口令牌（桌面版推送用，必设）
#   wrangler secret put VIEW_KEY    网页版登录墙密码（可选；设了之后读接口要校验，
#                                   网页版打开时会让访问者输这个密码才能看题）

name = "cuotiben-api"
main = "index.js"
compatibility_date = "2026-01-01"

[[d1_databases]]
binding = "DB"
database_name = "cuotiben"
database_id = "PUT_YOUR_D1_DATABASE_ID_HERE"

[[kv_namespaces]]
binding = "IMAGES"
id = "PUT_YOUR_KV_NAMESPACE_ID_HERE"
